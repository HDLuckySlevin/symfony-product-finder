{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-simplexml": "*",
        "helgesverre/milvus": "^0.1.0",
        "openai-php/client": "^0.13.0",
        "symfony/console": "6.4.*",
        "symfony/dotenv": "6.4.*",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "6.4.*",
        "symfony/http-client": "6.4.*",
        "symfony/mime": "6.4.*",
        "symfony/monolog-bundle": "^3.10",
        "symfony/property-access": "6.4.*",
        "symfony/runtime": "6.4.*",
        "symfony/serializer": "6.4.*",
        "symfony/translation": "6.4.*",
        "symfony/twig-bundle": "6.4.*",
        "symfony/validator": "6.4.*",
        "symfony/yaml": "6.4.*"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "docs:init": [
            "mkdir -p docs/_generated"
        ],
        "docs:generate": [
            "@docs:init",

            "composer show -D > docs/_generated/composer-deps.txt || true",
            "bash -lc '{ command -v jq >/dev/null 2>&1 && jq . composer.json > docs/_generated/composer.json.pretty; } || cp composer.json docs/_generated/composer.json.pretty'",

            "php bin/console about > docs/_generated/symfony-about.txt",
            "php bin/console debug:router --format=json > docs/_generated/router.json",
            "php bin/console debug:container --show-arguments > docs/_generated/container.txt",
            "php bin/console debug:autowiring > docs/_generated/autowiring.txt",

            "bash -lc 'php bin/console list --raw | grep -qx \"doctrine:mapping:info\" && php bin/console doctrine:mapping:info > docs/_generated/doctrine-mapping.txt || true'",
            "bash -lc 'php bin/console list --raw | grep -qx \"doctrine:schema:validate\" && php bin/console doctrine:schema:validate --skip-sync > docs/_generated/doctrine-validate.txt || true'",

            "php bin/console messenger:stats > docs/_generated/messenger-stats.txt 2>/dev/null || true",
            "php bin/console debug:scheduler > docs/_generated/scheduler.txt 2>/dev/null || true",

            "test -f vendor/bin/phpunit && vendor/bin/phpunit --list-tests > docs/_generated/phpunit-tests.txt || true",
            "test -f vendor/bin/phpstan && vendor/bin/phpstan analyse --error-format=json > docs/_generated/phpstan.json || true",
            "test -f vendor/bin/rector && vendor/bin/rector process --dry-run > docs/_generated/rector-dry-run.txt || true"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "6.4.*"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5"
    }
}
