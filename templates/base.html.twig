<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>">
        {% block stylesheets %}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        {% endblock %}

        {% block javascripts %}
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
            <!-- Markdown parser -->
            <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
            <!-- XSS-Schutz -->
            <script src="https://cdn.jsdelivr.net/npm/dompurify@3.1.7/dist/purify.min.js"></script>
            <!-- Optional: Syntax-Highlighting für ```code``` -->
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/highlight.js@11.9.0/styles/github.min.css">
            <script src="https://cdn.jsdelivr.net/npm/highlight.js@11.9.0/lib/highlight.min.js"></script>

        {% endblock %}
    </head>
    <body>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom">
            <div class="container">
                <a class="navbar-brand" href="{{ path('app_home') }}">Vertriebsassistent</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
{#                <div class="collapse navbar-collapse" id="navbarNav">#}
{#                    <ul class="navbar-nav">#}
{#                        <li class="nav-item">#}
{#                            <a class="nav-link" href="{{ path('app_home') }}">Home</a>#}
{#                        </li>#}
{#                    </ul>#}
{#                </div>#}
            </div>
        </nav>

        <main id="main-content">
            {% block body %}{% endblock %}
        </main>

        <footer class="bg-black py-4">
            <div class="container text-center">
                <p style="color: #dddddd">&copy; {{ "now"|date("Y") }} Vertriebsassistent by adesso SE</p>
            </div>
        </footer>
    </body>
</html>

<style>
    html, body {
        height: 100%;
        margin: 0;
    }

    body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
    }

    /* Main expands to take remaining space between header and footer */
    main#main-content {
        flex: 1 1 auto;
        display: block; /* keep default flow for your content */
    }

    /* Make .background fill the whole main area (so the gradient reaches footer) */
    .background {
        min-height: 100%;
        /* If you want content vertically centered, you can add:
           display:flex; flex-direction:column; justify-content:center; */
    }

    /* Footer should not add extra vertical margin */
    footer {
        margin: 0;
        flex-shrink: 0;
    }

    /* Navbar custom styling (global) */
    .navbar-custom {
        /*background: linear-gradient(90deg, #2b2fc6 0%, #007bff 100%);*/
        /*background: rgba(255,255,255,0.95);*/
        background: rgba(0,0,0,0.95);
        /*color: #212529;*/
        color: #ffffff;
    }

    .navbar-custom .navbar-brand {
        color: #ffffff;
        /*color: #212529;*/
        font-weight: 700;
        font-size: 1.125rem;
    }

    .navbar-custom .nav-link {
        /*color: rgba(255,255,255,0.95);*/
        /*color: #212529;*/
        color: #ffffff;
    }
    .navbar-custom .nav-link:hover,
    .navbar-custom .nav-link:focus {
        color: rgba(255, 255, 255, 0.5);
        text-decoration: underline;
    }

    /* Make the toggler visible on dark background */
    .navbar-custom .navbar-toggler {
        border-color: rgba(255,255,255,0.12);
    }
    .navbar-custom .navbar-toggler-icon {
        filter: invert(1) brightness(1.2);
    }
</style>
